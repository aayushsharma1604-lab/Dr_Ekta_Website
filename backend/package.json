{
  "name": "dr-ekta-backend",
  "version": "1.0.0",
  "description": "Backend for Dr. Ekta Narula Dental Care",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "sanitize-html": "^2.13.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js",
    "setupFilesAfterFramework": [
      "<rootDir>/tests/setup/jest.setup.js"
    ],
    "testMatch": [
      "**/tests/integration/**/*.test.js",
      "**/tests/unit/**/*.test.js"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "node_modules/(?!(sanitize-html|htmlparser2|domhandler|domutils|parse5|entities|css-select|nth-check|boolbase|domelementtype|html-entities)/)"
    ],
    "moduleNameMapper": {
      "^sanitize-html$": "<rootDir>/tests/mocks/sanitize-html.js"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ],
    "coverageDirectory": "coverage"
  }
}
