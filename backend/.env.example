# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dr_ekta_db
# JWT
JWT_ACCESS_SECRET=dr.ekta.access.secret
JWT_REFRESH_SECRET=dr.ekta.refresh.secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Practo
PRACTO_PROFILE_URL=
PRACTO_BOOKING_URL=

# Google Analytics
GA_MEASUREMENT_ID=
GA_API_SECRET=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# Captcha (reCAPTCHA server-side verification - F10; leave empty for dev/test fallback)
RECAPTCHA_SECRET=

# Frontend URL (for CORS, comma-separated allowlist)
FRONTEND_URL=http://localhost:3000