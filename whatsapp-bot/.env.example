# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=set_a_random_verify_string
WHATSAPP_API_VERSION=v21.0

# Bot server
PORT=5000

# Provider: meta (WhatsApp Cloud API) or twilio (Twilio sandbox)
PROVIDER=twilio

# --- Twilio sandbox (https://www.twilio.com/docs/whatsapp/sandbox) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=

# Business config (overrides src/config/flow.json)
BUSINESS_NAME=Dr. Ekta Narula Dental Care
OWNER_PHONE=+919310378836
SUPPORT_PHONE=+919310378836

# Admin template for owner notification (approved utility template, e.g. "new_booking_alert").
# If empty, bot tries free-form text first and falls back to logging.
ADMIN_TEMPLATE_NAME=
ADMIN_TEMPLATE_LANG=en

# Patient confirmation template (approved utility template, e.g. "appointment_confirmed").
# If empty, plain text is attempted (works inside the 24h customer window).
PATIENT_TEMPLATE_NAME=

# Local file storage for bookings + audit log
DATA_DIR=./data

# Backend integration (existing clinic backend — creates a Lead on booking)
BACKEND_API_BASE=http://localhost:4000/api
BACKEND_ENQUIRY_PATH=/public/enquiry
BACKEND_TIMEOUT_MS=8000

# Simple key guarding GET /api/bookings
ADMIN_API_KEY=change_me
